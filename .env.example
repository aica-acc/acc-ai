# 복사해서 .env 로 사용. 경로는 비워두면 레포 기준 상대 위치(app/core/config.py)를 기본값으로 쓴다.
# --- API 키 ---
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
CLIPDROP_API_KEY=
PINECONE_API_KEY=
HUGGING_FACE_TOKEN=
TAVILY_API_KEY=
CLOUDCONVERT_API_KEY=
YOUTUBE_API_KEY=
SERPAPI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 경로 (필수: PROJECT_ROOT, FRONT_PROJECT_ROOT) ---
PROJECT_ROOT=.
FRONT_PROJECT_ROOT=../acc-front
FILE_ROOT=
# 선택: DATA_ROOT, EDITOR_ROOT_DIR, PROMOTION_DIR, BANNER_SAVE_DIR

# --- 서버 주소 ---
# 브라우저/백엔드가 AI 서버 정적 파일에 접근하는 주소
AI_PUBLIC_BASE_URL=http://127.0.0.1:5000
