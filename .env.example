# 복사해서 .env 로 사용. 경로는 비워두면 레포 기준 상대 위치(app/core/config.py)를 기본값으로 쓴다.
# --- API 키 ---
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
CLIPDROP_API_KEY=
PINECONE_API_KEY=
HUGGING_FACE_TOKEN=
TAVILY_API_KEY=
CLOUDCONVERT_API_KEY=
YOUTUBE_API_KEY=
SERPAPI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 경로 (필수: PROJECT_ROOT, FRONT_PROJECT_ROOT) ---
PROJECT_ROOT=.
# 생성물 저장 위치 (하위 public/data/promotion/...). 서버 쪽 폴더이며 브라우저는 백엔드 /files/ 로만 받는다.
# 예전 기본값 ../acc-front 는 vite 가 바로 보여 주게 하려던 것 (#27 이후 필요 없음). 백엔드 react.base-path 와 같은 폴더로
FRONT_PROJECT_ROOT=../data/local
FILE_ROOT=
# 선택: DATA_ROOT, EDITOR_ROOT_DIR, PROMOTION_DIR, BANNER_SAVE_DIR

# --- 서버 주소 ---
# 응답에 넣는 정적 파일 URL 의 공개 주소 (브라우저는 백엔드의 /static/** 중계를 거친다)
AI_PUBLIC_BASE_URL=http://127.0.0.1:8081
